{
  "name": "meoweo-shared",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Design system and browser primitives shared by the MeoWeo tool suites",
  "license": "UNLICENSED",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tailwindcss -i src/index.css -o dist/index.css --minify",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "lucide-react": ">=0.500.0",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.2",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "lucide-react": "^0.511.0",
    "prettier": "^3.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "brace-expansion": "^5.0.9"
  }
}
